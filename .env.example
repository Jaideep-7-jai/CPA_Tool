# Copy these values into the service's environment; never commit real values.
FLASK_SECRET_KEY=
CPA_DB_HOST=
CPA_DB_USER=
CPA_DB_PASSWORD=
CPA_DB_NAME=CUST_TECH_DB
CPA_MT2_PASSWORD=
CPA_FTP_USERNAME=
CPA_FTP_PASSWORD=
CPA_FTP_HOST=

# Notification routing.  Keep group/member addresses in the service
# environment, not in source control.  CPA users get the FTP-only email view;
# technical/data-team recipients receive local and S3 audit details.
CPA_EMAIL_TECH_RECIPIENTS=
CPA_EMAIL_DATATEAM_RECIPIENTS=
CPA_EMAIL_CPA_RECIPIENTS=
CPA_EMAIL_CPA_USERNAMES=cpauser

# Existing Snowflake/S3 configuration continues to be read from config.py or
# the environment configured for the service.
